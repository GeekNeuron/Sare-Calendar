[{"n":"آبتین","g":"m","m":"نام پدر فریدون در شاهنامه","r":"اوستایی (Āθβiia)"},{"n":"آتوسا","g":"f","m":"دختر کوروش بزرگ و همسر داریوش یکم","r":"پارسی باستان (Utauθa)"},{"n":"آذر","g":"u","m":"آتش","r":"اوستایی (ātar) ← پارسی میانه (ādur)","x":"نام ماه نهم سال."},{"n":"آرام","g":"u","m":"آسوده و بی‌تنش","r":"پارسی"},{"n":"آرتا","g":"m","m":"راستی و پاکی","r":"پارسی باستان (arta)","x":"در فرهنگ ایران باستان، «ارته» اصل راستی و نظم جهان است."},{"n":"آرزو","g":"f","m":"خواست و امید","r":"پارسی میانه (arzūg)"},{"n":"آرش","g":"m","m":"پهلوان تیرانداز که تیرش مرز ایران و توران را نشان داد","r":"اوستایی (Erexša)","x":"در اوستا «تیز» و «تیزتاز» توصیف شده است."},{"n":"آرمان","g":"m","m":"آرزو، هدف و امید","r":"پارسی میانه (armān)"},{"n":"آرمیتا","g":"f","m":"فروتنی و اندیشه‌ی درست","r":"اوستایی (Spəntā Ārmaiti)","x":"نگاهبان زمین در باور ایران باستان."},{"n":"آریا","g":"m","m":"ایرانی، آریایی؛ نجیب","r":"پارسی باستان (ariya)","x":"شکل کوتاه‌شده‌ی آرین."},{"n":"آرین","g":"m","m":"ایرانی، آریایی؛ نجیب و آزاده","r":"پارسی باستان (ariya)"},{"n":"آزاده","g":"f","m":"رها و نجیب","r":"پارسی میانه (āzātag)"},{"n":"آسمان","g":"u","m":"سپهر بالا","r":"اوستایی (asman)"},{"n":"آناهیتا","g":"f","m":"پاک و بی‌آلایش","r":"اوستایی (Anāhitā)","x":"ایزدبانوی آب‌ها و باروری."},{"n":"آوا","g":"f","m":"صدا و آواز","r":"پارسی"},{"n":"اردشیر","g":"m","m":"کسی که فرمانروایی‌اش بر پایه‌ی راستی است","r":"پارسی باستان (Artaxšaça)","x":"نام چند شاه هخامنشی و بنیان‌گذار شاهنشاهی ساسانی."},{"n":"ارغوان","g":"f","m":"درخت و گلی با شکوفه‌های ارغوانی","r":"پارسی"},{"n":"اشکان","g":"m","m":"منسوب به اشکانیان","r":"پارتی (Aršak)","x":"برگرفته از نام اَرشَک، بنیان‌گذار دودمان اشکانی."},{"n":"انوشیروان","g":"m","m":"دارای روان جاودان","r":"پارسی میانه (Anōšag-ruwān)","x":"لقب خسرو یکم ساسانی."},{"n":"ایرج","g":"m","m":"ایرانی؛ وابسته به «ایر» (آریایی)","r":"اوستایی (Airiia)","x":"پسر کوچک فریدون در شاهنامه، که شاهی ایران به او رسید."},{"n":"بابک","g":"m","m":"پدرِ کوچک؛ نامی مهرآمیز","r":"پارسی میانه (Pāpak)","x":"نام پدر اردشیر ساسانی و نام بابک خرمدین."},{"n":"باران","g":"u","m":"قطره‌های آبی که از آسمان می‌بارد","r":"پارسی"},{"n":"بانو","g":"f","m":"زنِ بزرگ‌منش؛ بانوی خانه","r":"پارسی میانه (bānūg)"},{"n":"برزین","g":"m","m":"بلندپایه، رفیع و باشکوه","r":"پارسی (از «برز» به‌معنای بلندی)"},{"n":"بهار","g":"f","m":"نخستین فصل سال","r":"پارسی میانه (wahār)"},{"n":"بهرام","g":"m","m":"پیروزی؛ پیروزمند","r":"اوستایی (Vərəθraγna) ← پارسی میانه (Warahrān)","x":"نام ایزد پیروزی و چند شاه ساسانی."},{"n":"بهزاد","g":"m","m":"نیک‌زاده، خوش‌نژاد","r":"پارسی (به + زاد)","x":"در شاهنامه نام اسب سیاوش نیز هست."},{"n":"بهمن","g":"m","m":"اندیشه‌ی نیک","r":"اوستایی (Vohu Manah)","x":"نام ماه یازدهم سال و نام شاهی در شاهنامه."},{"n":"بهنوش","g":"f","m":"نوش‌جان؛ گوارا و خوشایند","r":"پارسی (به + نوش)"},{"n":"ترانه","g":"f","m":"سرود و آواز","r":"پارسی"},{"n":"جمشید","g":"m","m":"یَمِ درخشان","r":"اوستایی (Yima Xšaēta)","x":"در شاهنامه پادشاه بنیان‌گذار نوروز است."},{"n":"خسرو","g":"m","m":"دارای آوازه‌ی نیک؛ نیک‌نام","r":"اوستایی (Haosravah) ← پارسی میانه (Husraw)"},{"n":"خشایار","g":"m","m":"فرمانروای مردان؛ شاهِ دلاوران","r":"پارسی باستان (Xšayāršā)","x":"برگرفته از نام خشایارشا."},{"n":"دارا","g":"m","m":"دارنده؛ توانگر","r":"پارسی باستان","x":"شکل کوتاه داریوش و نام آخرین شاه هخامنشی در شاهنامه."},{"n":"داریوش","g":"m","m":"نگاهدارنده‌ی نیکی","r":"پارسی باستان (Dārayavauš)","x":"نام سه شاه هخامنشی."},{"n":"دریا","g":"u","m":"پهنه‌ی بزرگ آب","r":"پارسی میانه (drayāb)"},{"n":"دیبا","g":"f","m":"پارچه‌ی ابریشمیِ گران‌بها","r":"پارسی"},{"n":"رادمان","g":"m","m":"بخشنده و جوانمرد","r":"پارسی (راد + مان)"},{"n":"رامین","g":"m","m":"شادمان و آرامش‌بخش","r":"پارسی (از «رام» به‌معنای آرامش و شادی)","x":"دلداده‌ی ویس در منظومه‌ی «ویس و رامین»."},{"n":"رخشان","g":"f","m":"درخشان و تابان","r":"پارسی"},{"n":"رستم","g":"m","m":"پهلوان بزرگ شاهنامه","r":"پارسی میانه (Rōdestahm)","x":"ریشه‌ی واژه را «رودِ نیرومند» یا «تنومند» دانسته‌اند؛ نظر قطعی نیست."},{"n":"رها","g":"u","m":"آزاد و بی‌بند","r":"پارسی"},{"n":"رودابه","g":"f","m":"همسر زال و مادر رستم در شاهنامه","r":"شاهنامه"},{"n":"روشنک","g":"f","m":"روشنیِ کوچک؛ نام همسر اسکندر در شاهنامه","r":"پارسی (از «روشن»)"},{"n":"زرین","g":"f","m":"زرنما؛ ساخته‌شده از زر","r":"پارسی"},{"n":"سام","g":"m","m":"پهلوان اسطوره‌ای، نیای رستم","r":"اوستایی (Sāma)"},{"n":"ستاره","g":"f","m":"اخترِ آسمان","r":"پارسی میانه (stārag)"},{"n":"سروش","g":"m","m":"فرمان‌بری و شنیدن؛ پیام‌آور","r":"اوستایی (Sraoša)","x":"در ایران باستان نام ایزد نگاهبان و پیام‌آور."},{"n":"سهراب","g":"m","m":"پسر رستم و تهمینه در شاهنامه","r":"پارسی (به‌گمان «سُهر» به‌معنای سرخ و درخشان + «آب»)"},{"n":"سپیده","g":"f","m":"روشنی بامدادی؛ سپید","r":"پارسی"},{"n":"سیامک","g":"m","m":"پسر کیومرث؛ برگرفته از «سیاه»","r":"اوستایی (Syāmaka)"},{"n":"سیاوش","g":"m","m":"دارنده‌ی اسب سیاه","r":"اوستایی (Syāvaršan)","x":"شاهزاده‌ی بی‌گناه شاهنامه."},{"n":"سیمین","g":"f","m":"نقره‌ای؛ سیمگون","r":"پارسی (سیم به‌معنای نقره)"},{"n":"شادی","g":"f","m":"خوشحالی و سرور","r":"پارسی"},{"n":"شاهرخ","g":"m","m":"دارای رخساره‌ی شاهانه","r":"پارسی (شاه + رخ)"},{"n":"شاهین","g":"m","m":"باز شکاری؛ نمادِ بلندپروازی","r":"پارسی میانه (šāhēn)"},{"n":"شایان","g":"m","m":"شایسته و سزاوار","r":"پارسی (از شایستن)"},{"n":"شبنم","g":"f","m":"قطره‌های آب بر برگ و گل در بامداد","r":"پارسی (شب + نم)"},{"n":"شهرزاد","g":"f","m":"آزاده‌نژاد؛ دارای تبار شاهانه","r":"پارسی میانه (Čihrāzād)","x":"راوی هزار و یک شب."},{"n":"شیده","g":"f","m":"روشنی و درخشندگی","r":"اوستایی (xšaēta)"},{"n":"شیرین","g":"f","m":"خوش‌مزه و دلنشین","r":"پارسی میانه (šīrēn)","x":"همسر خسرو پرویز در روایت‌های ایرانی."},{"n":"فرزاد","g":"m","m":"نیک‌نژاد؛ زاده‌ی فَرّ","r":"پارسی (فَر + زاد)"},{"n":"فرزانه","g":"f","m":"دانا و خردمند","r":"پارسی میانه (frazānag)"},{"n":"فرشته","g":"f","m":"فرستاده و پیام‌آور","r":"پارسی میانه (frēštag)"},{"n":"فرشید","g":"m","m":"دارای فَرّ و درخشش","r":"پارسی (فَر + شید به‌معنای روشنی)"},{"n":"فرنگیس","g":"f","m":"دختر افراسیاب و مادر کیخسرو در شاهنامه","r":"شاهنامه"},{"n":"فرهاد","g":"m","m":"فرهیخته و آموخته","r":"پارسی میانه (Frahād)","x":"شیفته‌ی شیرین در منظومه‌های ایرانی."},{"n":"فریبا","g":"f","m":"زیبا و دلربا","r":"پارسی"},{"n":"فریدون","g":"m","m":"پادشاه اسطوره‌ای که ضحاک را شکست داد","r":"اوستایی (Θraētaona)"},{"n":"ماندانا","g":"f","m":"مادر کوروش بزرگ","r":"نام برآمده از منابع یونانی (Mandane)"},{"n":"ماهان","g":"m","m":"وابسته به ماه؛ نام شهری در کرمان","r":"پارسی"},{"n":"ماهرخ","g":"f","m":"دارای چهره‌ی ماه‌گون","r":"پارسی (ماه + رخ)"},{"n":"مهتاب","g":"f","m":"روشنی ماه","r":"پارسی (ماه + تاب)"},{"n":"مهر","g":"u","m":"دوستی، پیمان و خورشید","r":"اوستایی (Miθra)","x":"نام ایزد پیمان و روشنایی و نام ماه هفتم سال."},{"n":"مهران","g":"m","m":"وابسته به مهر","r":"پارسی میانه (Mihrān)","x":"نام یکی از خاندان‌های بزرگ دوران اشکانی."},{"n":"مهرداد","g":"m","m":"داده‌ی مهر","r":"پارسی باستان (Miθradāta)","x":"نام چند شاه اشکانی و پونتی."},{"n":"مهسا","g":"f","m":"ماه‌سان؛ همچون ماه","r":"پارسی (ماه + سا)"},{"n":"مهشید","g":"f","m":"ماهِ درخشان","r":"پارسی (ماه + شید)"},{"n":"مهیار","g":"m","m":"یار و یاور ماه","r":"پارسی (ماه + یار)"},{"n":"مینو","g":"f","m":"بهشت و جهان روشن","r":"اوستایی (mainiiu) ← پارسی میانه (mēnōg)"},{"n":"نازنین","g":"f","m":"نازک و دوست‌داشتنی","r":"پارسی"},{"n":"نسرین","g":"f","m":"گلی سپید و خوشبو از گونه‌ی نسترن","r":"پارسی"},{"n":"نوید","g":"m","m":"مژده و خبر خوش","r":"پارسی"},{"n":"نگار","g":"f","m":"دلبر و زیبا؛ نقش و تصویر","r":"پارسی میانه (nigār)"},{"n":"نگین","g":"f","m":"سنگ گران‌بهای انگشتر؛ گوهر","r":"پارسی"},{"n":"نیکا","g":"f","m":"نیک و خوب","r":"پارسی (از «نیک»)"},{"n":"هستی","g":"f","m":"وجود و جهان","r":"پارسی"},{"n":"هما","g":"f","m":"پرنده‌ی افسانه‌ای و خوش‌اقبال؛ نمادِ بخت بلند","r":"پارسی میانه (humāy)","x":"نام دختر بهمن در شاهنامه."},{"n":"هوشنگ","g":"m","m":"دارای خانه‌ی نیک","r":"اوستایی (Haošyaŋha)","x":"دومین پادشاه شاهنامه و بنیان‌گذار جشن سده."},{"n":"هومن","g":"m","m":"اندیشه‌ی نیک","r":"اوستایی (Vohu Manah)","x":"شکل دیگر «بهمن»."},{"n":"هژبر","g":"m","m":"شیر؛ دلاور","r":"پارسی"},{"n":"هیوا","g":"f","m":"امید","r":"کردی"},{"n":"پرستو","g":"f","m":"پرنده‌ای مهاجر؛ نشانِ بهار و بازگشت","r":"پارسی"},{"n":"پروین","g":"f","m":"خوشه‌ی ستارگان ثریا","r":"پارسی میانه (parwēn)"},{"n":"پریسا","g":"f","m":"پری‌سان؛ همچون پری","r":"پارسی (پری + سا)"},{"n":"پریناز","g":"f","m":"پریِ نازنین","r":"پارسی (پری + ناز)"},{"n":"پویا","g":"m","m":"جنبنده و پرتکاپو","r":"پارسی (از پوییدن)"},{"n":"پگاه","g":"f","m":"بامداد و سپیده‌دم","r":"پارسی"},{"n":"پیمان","g":"m","m":"عهد و قرار؛ همچنین اندازه","r":"پارسی میانه (paymān)"},{"n":"ژاله","g":"f","m":"شبنم؛ قطره‌های ریز باران","r":"پارسی"},{"n":"کامران","g":"m","m":"کامیاب؛ پیروز و خوشبخت","r":"پارسی (کام + ران)"},{"n":"کاوه","g":"m","m":"آهنگرِ دادخواه که بر ضحاک شورید","r":"شاهنامه","x":"درفش کاویانی در شاهنامه از پیش‌بند چرمینِ او ساخته شد."},{"n":"کوروش","g":"m","m":"بنیان‌گذار شاهنشاهی هخامنشی","r":"پارسی باستان (Kuruš)","x":"ریشه‌ی دقیقش میان پژوهشگران ناهمسان است؛ در برخی روایت‌های یونانی با «خورشید» پیوند داده شده."},{"n":"کیان","g":"m","m":"شاهان؛ وابسته به دودمان کیانی","r":"اوستایی (kavi) ← پارسی (کی)","x":"«کی» به‌معنای شاه است."},{"n":"کیومرث","g":"m","m":"زندگیِ میرا؛ نخستین انسان و پادشاه","r":"اوستایی (Gaya Maretan)"},{"n":"گلناز","g":"f","m":"گلِ نازنین","r":"پارسی (گل + ناز)"},{"n":"گیتی","g":"f","m":"جهان و هستیِ مادی","r":"پارسی میانه (gētī) ← اوستایی (gaēθā)"},{"n":"یاور","g":"m","m":"یاری‌گر و همراه","r":"پارسی میانه (yāwar)"},{"n":"یزدان","g":"m","m":"آفریدگار؛ آنچه شایسته‌ی ستایش است","r":"اوستایی (yazata)"}]